{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "disabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions that follow a '# renovate:' comment in the Dockerfile",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Digest-pinned images named inside run: lines of the workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "One image:tag@digest per line in the test servers list",
      "managerFilePatterns": [
        "/^test\\/servers$/"
      ],
      "matchStrings": [
        "(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Patch and digest updates change the image and publish themselves, so each waits three days to let a bad release be pulled first; a datasource with no release timestamps is not held back",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "labels": [
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "A replacement is a different package, so it waits for review like a minor",
      "matchUpdateTypes": [
        "minor",
        "replacement"
      ],
      "labels": [
        "minor"
      ]
    },
    {
      "description": "A new major is added to the build and tests on purpose, so it waits for approval",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Actions pins and test servers only change CI, so they replace the update-type label",
      "matchFileNames": [
        ".github/**",
        "test/servers"
      ],
      "labels": [
        "ci"
      ]
    },
    {
      "description": "A test server line gets its own branch and pull request, so that the Dockerfile's update of the same image keeps its patch label and stays in the release notes",
      "matchFileNames": [
        "test/servers"
      ],
      "additionalBranchPrefix": "test-servers-"
    },
    {
      "description": "supercronic publishes no checksums, so its per-architecture SHA-256 ARGs are edited by hand",
      "matchPackageNames": [
        "aptible/supercronic"
      ],
      "automerge": false
    },
    {
      "description": "Each test server line is a supported version series, so only its digest moves; a new series is added by hand, and a major on the dashboard is the prompt to do so",
      "matchFileNames": [
        "test/servers"
      ],
      "matchPackageNames": [
        "postgres",
        "mariadb",
        "mysql"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
