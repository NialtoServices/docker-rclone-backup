#!/bin/sh
#
# Mirrors BACKUP_SOURCE to BACKUP_TARGET with rclone sync, deleting from the target whatever the
# source lacks. With --check, validates the settings, prints nothing and exits 0.

set -eu

umask 077

. /usr/local/lib/rclone-backup/log.sh

CHECK_ONLY=false

case "${1:-}" in
  --check) CHECK_ONLY=true ;;
  "") ;;
  *) fatal "unknown argument '$1'" ;;
esac

[ -n "${BACKUP_SOURCE:-}" ] || fatal "'BACKUP_SOURCE' is not set"
[ -n "${BACKUP_TARGET:-}" ] || fatal "'BACKUP_TARGET' is not set"

# A relative path resolves against the working directory, which differs between scheduled and manual
# runs, and always lands inside the container's own filesystem.
for LOCATION in "${BACKUP_SOURCE}" "${BACKUP_TARGET}"
do
  case "${LOCATION%%/*}" in
    *:* | "") ;;
    *) fatal "'${LOCATION}' is neither an rclone remote (remote:path) nor an absolute path" ;;
  esac
done

if [ "${CHECK_ONLY}" = true ]
then
  exit 0
fi

info "syncing ${BACKUP_SOURCE} to ${BACKUP_TARGET}"
rclone sync --stats-log-level NOTICE "${BACKUP_SOURCE}" "${BACKUP_TARGET}" || fatal "failed to sync ${BACKUP_SOURCE} to ${BACKUP_TARGET}"

info "sync complete: ${BACKUP_SOURCE} -> ${BACKUP_TARGET}"
