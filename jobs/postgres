#!/bin/sh
#
# Dumps DATABASE_NAME with the pg_dump of the server's own major, checks the archive and uploads it to
# BACKUP_TARGET as <DATABASE_NAME>.dump. With --check, validates the settings, prints nothing and
# exits 0.

set -eu -o pipefail

umask 077

. /usr/local/lib/rclone-backup/log.sh
. /usr/local/lib/rclone-backup/settings.sh
. /usr/local/lib/rclone-backup/job.sh

CHECK_ONLY=false

case "${1:-}" in
  --check) CHECK_ONLY=true ;;
  "") ;;
  *) fatal "unknown argument '$1'" ;;
esac

POSTGRES_BIN_DIRECTORY=/usr/lib/postgresql

refuse_unknown_settings DATABASE_HOST DATABASE_PORT DATABASE_USER DATABASE_PASSWORD DATABASE_PASSWORD_FILE DATABASE_NAME DATABASE_TLS DATABASE_TLS_CA_PATH BACKUP_STAGING_PATH
require_settings DATABASE_HOST DATABASE_USER DATABASE_NAME BACKUP_TARGET
require_location BACKUP_TARGET
require_object_name DATABASE_NAME
require_database_port
load_database_password
require_database_tls

if [ "${CHECK_ONLY}" = true ]
then
  exit 0
fi

acquire_run_lock
open_staging_directory

SERVER_PORT="${DATABASE_PORT:-5432}"

# Runs a command with the connection details in its environment. The password and every other detail
# reach the tools this way, never their arguments, which any process in the container can read, and
# the subshell keeps them out of the environment of rclone and everything else the job starts.
with_connection_environment() {
  (
    export PGHOST="${DATABASE_HOST}"
    export PGPORT="${SERVER_PORT}"
    export PGUSER="${DATABASE_USER}"
    export PGPASSWORD="${DATABASE_PASSWORD}"
    export PGDATABASE="${DATABASE_NAME}"
    export PGCONNECT_TIMEOUT=10

    case "${DATABASE_TLS}" in
      disabled) export PGSSLMODE=disable ;;
      required) export PGSSLMODE=require ;;
      verify)
        export PGSSLMODE=verify-full

        # `system` makes libpq trust the operating system's CA certificates; without it libpq looks for
        # a root certificate in a home directory this image doesn't have.
        export PGSSLROOTCERT="${DATABASE_TLS_CA_PATH:-system}"
        ;;
    esac

    exec "$@"
  )
}

# Any major's psql can read the version of any server, so the newest installed does it.
NEWEST_CLIENT_MAJOR=0
for CLIENT_DIRECTORY in "${POSTGRES_BIN_DIRECTORY}"/*/
do
  CLIENT_MAJOR="${CLIENT_DIRECTORY%/}"
  CLIENT_MAJOR="${CLIENT_MAJOR##*/}"

  case "${CLIENT_MAJOR}" in
    "" | *[!0-9]*) continue ;;
  esac

  [ -x "${CLIENT_DIRECTORY}bin/psql" ] || continue

  [ "${CLIENT_MAJOR}" -le "${NEWEST_CLIENT_MAJOR}" ] || NEWEST_CLIENT_MAJOR="${CLIENT_MAJOR}"
done

[ "${NEWEST_CLIENT_MAJOR}" -gt 0 ] || fatal "no PostgreSQL client is installed under ${POSTGRES_BIN_DIRECTORY}"

SERVER_VERSION_NUMBER="$(with_connection_environment "${POSTGRES_BIN_DIRECTORY}/${NEWEST_CLIENT_MAJOR}/bin/psql" -XAtc 'SHOW server_version_num')" \
  || fatal "failed to connect to ${DATABASE_HOST}:${SERVER_PORT} as '${DATABASE_USER}' to read the server's version"

case "${SERVER_VERSION_NUMBER}" in
  "" | *[!0-9]*) fatal "the server at ${DATABASE_HOST}:${SERVER_PORT} reported a version that can't be read: '${SERVER_VERSION_NUMBER}'" ;;
esac

SERVER_MAJOR=$((SERVER_VERSION_NUMBER / 10000))
CLIENT_BIN_DIRECTORY="${POSTGRES_BIN_DIRECTORY}/${SERVER_MAJOR}/bin"

[ -x "${CLIENT_BIN_DIRECTORY}/pg_dump" ] \
  || fatal "PostgreSQL ${SERVER_MAJOR} isn't supported; this image has clients for 15 to 18"

DUMP_PATH="${STAGING_DIRECTORY}/dump.custom"

# pg_dump takes a shared lock on every table before it reads any, and it waits behind a migration
# holding an exclusive lock. A minute outlasts the short exclusive locks of normal traffic, while a
# migration or transaction stuck for longer fails the run, and so alerts the monitor, instead of the
# dump waiting for it until the next scheduled run.
info "dumping ${DATABASE_NAME} from PostgreSQL ${SERVER_MAJOR} at ${DATABASE_HOST}:${SERVER_PORT}"
with_connection_environment "${CLIENT_BIN_DIRECTORY}/pg_dump" --format=custom --lock-wait-timeout=60s --file="${DUMP_PATH}" \
  || fatal "failed to dump ${DATABASE_NAME}"

"${CLIENT_BIN_DIRECTORY}/pg_restore" --list "${DUMP_PATH}" > /dev/null \
  || fatal "the dump of ${DATABASE_NAME} can't be read back"

upload_staged_file "${DUMP_PATH}" "${DATABASE_NAME}.dump"

info "backup complete: ${DATABASE_NAME} -> ${BACKUP_TARGET}"
