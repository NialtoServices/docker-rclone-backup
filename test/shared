#!/bin/sh
#
# Tests for the behaviour every image shares, run against the files image from anywhere on a host
# with Docker:
#
#   test/shared IMAGE
#
# Each run's output goes to a log file that is shown only when a check fails.

# The single-quoted scripts passed to `sh -c` expand inside the container, not on the host.
# shellcheck disable=SC2016

set -eu

if [ "$#" -ne 1 ]
then
  echo "usage: $0 IMAGE" >&2
  exit 2
fi

IMAGE="$1"
TEST_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=lib.sh
. "${TEST_DIR}/lib.sh"

make_work_dir "${IMAGE}"

CONTAINER_NAME="rclone-backup-shared-$$"
NETWORK_NAME="rclone-backup-shared-$$"
TARGET_DIR="${WORK_DIR}/target"
TAB="$(printf '\t')"

mkdir -m 0777 "${TARGET_DIR}"

# The fake monitor has to be gone before its network can be removed.
cleanup() {
  CLEANUP_STATUS=$?
  docker rm --force "${CONTAINER_NAME}" > /dev/null 2>&1 || true
  stop_fake_monitor
  docker network rm "${NETWORK_NAME}" > /dev/null 2>&1 || true
  remove_work_dir "${CLEANUP_STATUS}"
}

trap cleanup EXIT

docker network create "${NETWORK_NAME}" > /dev/null

# Runs start in the foreground for at most 10 seconds, with the given docker run options, saving its
# output. The timeout runs inside the container, so a start that doesn't stop is reported as exit 124
# rather than left running on the host.
run_start() {
  hardened_run --user 1000:1000 "$@" "${IMAGE}" timeout 10 /usr/local/bin/start > "${LOG_FILE}" 2>&1
}

run_start_with_valid_settings() {
  run_start -e BACKUP_SOURCE=/source -e BACKUP_TARGET=remote:bucket "$@"
}

# Runs a throwaway container on the fake monitor's network with all three monitor URLs set.
hardened_run_with_monitor() {
  hardened_run --user 1000:1000 --network "${NETWORK_NAME}" \
    -e "MONITOR_START_URL=http://${FAKE_MONITOR_NAME}:8080/start" \
    -e "MONITOR_SUCCESS_URL=http://${FAKE_MONITOR_NAME}:8080/success" \
    -e "MONITOR_FAILURE_URL=http://${FAKE_MONITOR_NAME}:8080/fail" \
    "$@"
}

# Starts the container in the background with valid settings plus the given docker run options.
start_in_background() {
  hardened_run --detach --name "${CONTAINER_NAME}" --user 1000:1000 \
    -e BACKUP_SOURCE=/source -e BACKUP_TARGET=remote:bucket \
    "$@" \
    "${IMAGE}" > /dev/null
}

is_running() {
  [ "$(docker inspect --format '{{.State.Running}}' "${CONTAINER_NAME}" 2> /dev/null)" = "true" ]
}

# Saves the background container's output where with_log can show it, then removes the container.
finish_background() {
  docker logs "${CONTAINER_NAME}" > "${LOG_FILE}" 2>&1 || true
  docker rm --force "${CONTAINER_NAME}" > /dev/null 2>&1 || true
}

logged_output_contains() {
  docker logs "${CONTAINER_NAME}" 2>&1 | grep -q -- "$1"
}

# Stops with exit 1 and a message containing $1, for the given docker run options.
start_stops_with_message() {
  EXPECTED_MESSAGE="$1"
  shift

  START_STATUS=0
  run_start_with_valid_settings "$@" || START_STATUS=$?

  [ "${START_STATUS}" -eq 1 ] && grep -q -- "${EXPECTED_MESSAGE}" "${LOG_FILE}"
}

valid_schedules_keep_running() {
  for SCHEDULE in '0 3 * * *' '@daily' '*/15 * * * *' '0 9,21 * * 1-5' '0 3 ? * *' "0${TAB}3 * * *" ' @daily ' '0  3 * * *'
  do
    start_in_background -e "BACKUP_SCHEDULE=${SCHEDULE}" -e UNRELATED_SETTING=1
    sleep 2

    if ! is_running
    then
      finish_background
      echo "'${SCHEDULE}' stopped the container" >&2
      return 1
    fi

    finish_background
  done
}

invalid_schedules_stop_the_container() {
  NEWLINE_SCHEDULE="$(printf '0 3 * * *\n* * * * *')"

  # supercronic reads the longest prefix that parses as a schedule and takes the rest as the command,
  # so any value that isn't one macro or exactly five fields has to be refused here.
  for SCHEDULE in '"0 3 * * *"' '0 3 * *' '0 3 * * * # nightly' '@reboot' '@daily foo' '@every 5m' "@daily${TAB}3" "${NEWLINE_SCHEDULE}" \
    ' @daily foo' "${TAB}@daily foo" '0 3 * * * echo' '0 3 * * 1 5' '0 0 3 * * *' '@daily * * * *' '* * * * * * *'
  do
    if ! start_stops_with_message "BACKUP_SCHEDULE must be" -e "BACKUP_SCHEDULE=${SCHEDULE}"
    then
      echo "'${SCHEDULE}' was not refused" >&2
      return 1
    fi
  done
}

# An unknown zone would otherwise fall back to UTC without a word, shifting every scheduled run.
time_zone_must_name_a_zoneinfo_file() {
  for TIME_ZONE in Europe/Lndon Europe ../zoneinfo/UTC 'UTC+1x'
  do
    if ! start_stops_with_message "'TZ' must name a time zone" -e "TZ=${TIME_ZONE}"
    then
      echo "'${TIME_ZONE}' was not refused" >&2
      return 1
    fi
  done

  for TIME_ZONE in Europe/London UTC :America/New_York
  do
    START_STATUS=0
    run_start_with_valid_settings -e "TZ=${TIME_ZONE}" || START_STATUS=$?

    if [ "${START_STATUS}" -ne 124 ]
    then
      echo "'${TIME_ZONE}' was refused" >&2
      return 1
    fi
  done
}

disabled_schedule_keeps_running_with_nothing_scheduled() {
  start_in_background -e BACKUP_SCHEDULE=disabled
  sleep 2

  is_running \
    && docker exec "${CONTAINER_NAME}" test ! -s /tmp/crontab \
    && docker exec "${CONTAINER_NAME}" pgrep -x supercronic > /dev/null
  DISABLED_STATUS=$?

  finish_background
  return "${DISABLED_STATUS}"
}

unknown_settings_stop_the_container() {
  start_stops_with_message "unknown settings: BACKUP_SOURSE, DATABASE_HOST" \
    -e BACKUP_SOURSE=/x -e DATABASE_HOST=database
}

missing_settings_stop_the_container_at_start() {
  START_STATUS=0
  run_start -e BACKUP_TARGET=remote:bucket || START_STATUS=$?
  [ "${START_STATUS}" -eq 1 ] && grep -q "'BACKUP_SOURCE' is not set" "${LOG_FILE}" || return 1

  START_STATUS=0
  run_start -e BACKUP_SOURCE=/source || START_STATUS=$?
  [ "${START_STATUS}" -eq 1 ] && grep -q "'BACKUP_TARGET' is not set" "${LOG_FILE}"
}

start_warns_without_a_success_url() {
  start_in_background
  wait_for logged_output_contains "MONITOR_SUCCESS_URL is not set, so a run that fails or never happens raises no alert"
  WARNING_STATUS=$?

  finish_background
  return "${WARNING_STATUS}"
}

start_is_quiet_with_a_success_url() {
  start_in_background -e MONITOR_SUCCESS_URL=http://monitor.invalid/success
  sleep 2

  is_running && ! logged_output_contains "MONITOR_SUCCESS_URL"
  QUIET_STATUS=$?

  finish_background
  return "${QUIET_STATUS}"
}

second_run_is_refused_while_one_is_running() {
  hardened_run --user 1000:1000 \
    -e BACKUP_SOURCE=/tmp/source \
    -e BACKUP_TARGET=/tmp/target \
    -e RCLONE_BWLIMIT=1M \
    "${IMAGE}" sh -c '
    set -e
    mkdir /tmp/source /tmp/target
    head -c 20000000 /dev/zero > /tmp/source/large

    /usr/local/bin/backup 2> /dev/null &
    FIRST_RUN_PID=$!

    for ATTEMPT in $(seq 1 30)
    do
      pgrep -x rclone > /dev/null && break
      sleep 1
    done
    pgrep -x rclone > /dev/null

    if SECOND_RUN_OUTPUT="$(/usr/local/bin/backup 2>&1)"
    then
      exit 1
    fi
    kill "${FIRST_RUN_PID}"

    echo "${SECOND_RUN_OUTPUT}" | grep "another backup is already running"
  ' > "${LOG_FILE}" 2>&1
}

target_has_partial_file() {
  docker exec "${CONTAINER_NAME}" sh -c 'ls -a /target | grep -q "\.partial$"'
}

stop_during_a_scheduled_backup() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  hardened_run_with_monitor --detach --name "${CONTAINER_NAME}" \
    -v "${TARGET_DIR}:/target" \
    -e 'BACKUP_SCHEDULE=* * * * *' \
    -e BACKUP_SOURCE=/tmp/source \
    -e BACKUP_TARGET=/target \
    -e RCLONE_BWLIMIT=1M \
    "${IMAGE}" sh -c '
    mkdir /tmp/source
    head -c 60000000 /dev/zero > /tmp/source/large
    exec /usr/local/bin/start
  ' > /dev/null || return 1

  wait_for_next_minute target_has_partial_file || return 1

  # At 1 MB/s the 60 MB source outlasts the grace period, so only a signalled backup stops in time.
  # The container is removed as soon as it stops, so its exit code has to be collected by a wait
  # that started before the stop.
  docker wait "${CONTAINER_NAME}" > "${WORK_DIR}/exit-code" &
  WAIT_PID=$!
  docker stop --time 20 "${CONTAINER_NAME}" > /dev/null || return 1
  wait "${WAIT_PID}" || return 1

  [ "$(cat "${WORK_DIR}/exit-code")" -eq 143 ] || return 1
  wait_for monitor_has_request '^POST /fail ' || return 1

  TARGET_LISTING="$(hardened_run --user 1000:1000 -v "${TARGET_DIR}:/target:ro" "${IMAGE}" ls -a /target)" || return 1
  case "${TARGET_LISTING}" in
    *.partial*) echo "a partial file was left behind: ${TARGET_LISTING}" >&2; return 1 ;;
  esac
}

monitor_hears_a_passing_run() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  hardened_run_with_monitor "${IMAGE}" /usr/local/bin/monitor true > "${LOG_FILE}" 2>&1 || return 1

  wait_for monitor_has_request '^GET /success ' \
    && monitor_has_request '^GET /start ' \
    && ! monitor_has_request '^POST /fail '
}

failing_run_keeps_its_status_and_sends_a_redacted_log() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  MONITOR_STATUS=0
  hardened_run_with_monitor "${IMAGE}" /usr/local/bin/monitor \
    sh -c 'echo "syncing :s3,secret_access_key=TOPSECRET:bucket"; exit 3' > "${LOG_FILE}" 2>&1 || MONITOR_STATUS=$?
  [ "${MONITOR_STATUS}" -eq 3 ] || return 1

  wait_for monitor_has_request '^POST /fail ' \
    && monitor_has_request 'secret_access_key=REDACTED' \
    && ! monitor_has_request 'TOPSECRET' \
    && ! monitor_has_request '^GET /success '
}

scheduled_run_reports_its_failure() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  hardened_run_with_monitor --detach --name "${CONTAINER_NAME}" \
    -e 'BACKUP_SCHEDULE=* * * * *' \
    -e BACKUP_SOURCE=/tmp/source \
    -e BACKUP_TARGET=/tmp/target \
    -e RCLONE_MAX_DELETE=0 \
    "${IMAGE}" sh -c '
    mkdir /tmp/source /tmp/target
    echo stale > /tmp/target/stale
    exec /usr/local/bin/start
  ' > /dev/null || return 1

  wait_for_next_minute monitor_has_request '^POST /fail ' \
    && monitor_has_request '^GET /start ' \
    && docker exec "${CONTAINER_NAME}" test -e /tmp/target/stale
  SCHEDULED_STATUS=$?

  finish_background
  return "${SCHEDULED_STATUS}"
}

monitor_url_stays_out_of_process_arguments() {
  # The start URL is refused, so curl keeps retrying for about 30 seconds, long enough to be seen.
  hardened_run --user 1000:1000 -e MONITOR_START_URL=http://127.0.0.1:1/secret-ping-token "${IMAGE}" sh -c '
    /usr/local/bin/monitor true 2> /dev/null &

    for ATTEMPT in $(seq 1 30)
    do
      pgrep -x curl > /dev/null && break
      sleep 1
    done
    pgrep -x curl > /dev/null

    ! ps -eo args | grep -q "[s]ecret-ping-token"
  ' > "${LOG_FILE}" 2>&1
}

stopped_run_reports_the_output_it_wrote_while_stopping() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  hardened_run_with_monitor "${IMAGE}" sh -c '
    setsid /usr/local/bin/monitor sh -c "
      trap \"echo cleaning-up-after-stop; exit 1\" TERM
      while true
      do
        sleep 1
      done
    " 2> /dev/null &
    MONITOR_PID=$!
    sleep 2
    pkill -TERM -g "${MONITOR_PID}"

    MONITOR_STATUS=0
    wait "${MONITOR_PID}" || MONITOR_STATUS=$?

    [ "${MONITOR_STATUS}" -eq 1 ]
  ' > "${LOG_FILE}" 2>&1 || return 1

  wait_for monitor_has_request 'cleaning-up-after-stop'
}

stop_before_the_run_starts_prevents_the_run() {
  start_fake_monitor "${NETWORK_NAME}" || return 1

  # The refused start ping keeps the wrapper busy, and the stop signal reaches its whole process
  # group, as the container's does.
  hardened_run_with_monitor -e MONITOR_START_URL=http://127.0.0.1:1/start "${IMAGE}" sh -c '
    setsid /usr/local/bin/monitor touch /tmp/ran 2> /dev/null &
    MONITOR_PID=$!
    sleep 2
    pkill -TERM -g "${MONITOR_PID}"

    MONITOR_STATUS=0
    wait "${MONITOR_PID}" || MONITOR_STATUS=$?

    [ "${MONITOR_STATUS}" -eq 143 ] && [ ! -e /tmp/ran ]
  ' > "${LOG_FILE}" 2>&1 || return 1

  wait_for monitor_has_request '^POST /fail '
}

rclone_is_quiet_about_a_missing_config_file() {
  RCLONE_OUTPUT="$(hardened_run --user 1000:1000 -e RCLONE_CONFIG_REMOTE_TYPE=local "${IMAGE}" rclone listremotes 2>&1)" \
    && [ "${RCLONE_OUTPUT}" = "remote:" ]
}

rclone_config_names_a_mounted_config_file() {
  printf '[mounted]\ntype = local\n' > "${WORK_DIR}/rclone.conf"

  RCLONE_OUTPUT="$(hardened_run --user 1000:1000 \
    -v "${WORK_DIR}/rclone.conf:/etc/rclone.conf:ro" \
    -e RCLONE_CONFIG=/etc/rclone.conf \
    "${IMAGE}" rclone listremotes 2>&1)" \
    && [ "${RCLONE_OUTPUT}" = "mounted:" ]
}

settings_helpers_refuse_bad_object_names() {
  for OBJECT_NAME in 'a/b' '.hidden' '../escape' '/absolute' '-hyphen' '--help'
  do
    if hardened_run -e "OBJECT_NAME=${OBJECT_NAME}" "${IMAGE}" sh -c '
      . /usr/local/lib/rclone-backup/log.sh
      . /usr/local/lib/rclone-backup/settings.sh
      require_object_name OBJECT_NAME
    ' > "${LOG_FILE}" 2>&1
    then
      echo "'${OBJECT_NAME}' was accepted" >&2
      return 1
    fi
  done

  hardened_run -e OBJECT_NAME=app.dump "${IMAGE}" sh -c '
    . /usr/local/lib/rclone-backup/log.sh
    . /usr/local/lib/rclone-backup/settings.sh
    require_object_name OBJECT_NAME
  ' > "${LOG_FILE}" 2>&1
}

check "a valid schedule is accepted" with_log valid_schedules_keep_running
check "an invalid schedule stops the container with exit 1" with_log invalid_schedules_stop_the_container
check "a TZ without a file in /usr/share/zoneinfo stops the container" with_log time_zone_must_name_a_zoneinfo_file
check "a disabled schedule keeps running with nothing scheduled" with_log disabled_schedule_keeps_running_with_nothing_scheduled
check "an unknown setting stops the container" with_log unknown_settings_stop_the_container
check "a missing required setting stops the container at start-up, not at the first run" with_log missing_settings_stop_the_container_at_start
check "start warns without a success URL" with_log start_warns_without_a_success_url
check "start does not warn with a success URL" with_log start_is_quiet_with_a_success_url
check "a second run is refused while one is running" with_log second_run_is_refused_while_one_is_running
check "the monitor hears the start and success of a passing run" with_log monitor_hears_a_passing_run
check "a failing run keeps its exit status and sends a redacted log" with_log failing_run_keeps_its_status_and_sends_a_redacted_log
check "a scheduled run reports its failure" with_log scheduled_run_reports_its_failure
check "docker stop lets a scheduled backup clean up, report its failure and exit 143" with_log stop_during_a_scheduled_backup
check "a stopped run reports the output it wrote while stopping" with_log stopped_run_reports_the_output_it_wrote_while_stopping
check "a stop signal before the run starts prevents the run" with_log stop_before_the_run_starts_prevents_the_run
check "a monitor URL never appears in process arguments" with_log monitor_url_stays_out_of_process_arguments
check "an object name with a slash, a leading dot or a leading hyphen is refused" with_log settings_helpers_refuse_bad_object_names
check "rclone is quiet about a missing config file" with_log rclone_is_quiet_about_a_missing_config_file
check "RCLONE_CONFIG still names a mounted config file" with_log rclone_config_names_a_mounted_config_file
